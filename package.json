    "release": "npm run check && node scripts/release.mjs"
  },
  "dependencies": { "yaml": "^2.8.1" },
  "devDependencies": { "@types/node": "^22.18.0", "typescript": "~5.9.3", "vite": "^7.1.9", "vitest": "^3.2.4" }
}
