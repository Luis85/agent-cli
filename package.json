{
  "name": "@luis85/agent-cli", "version": "0.1.0", "private": true,
  "description": "Portable, agent-friendly development and Obsidian vault CLI",
  "type": "module", "license": "MIT", "engines": { "node": ">=22.12.0" },
  "bin": { "agent-cli": "bin/app/app.cjs" },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit", "build": "vite build && node scripts/package.mjs",
