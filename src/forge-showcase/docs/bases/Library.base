filters:
  and:
    - file.ext == "md"
    - file.inFolder("library")
views:
  - type: table
    name: Trailhead definitions
    filters: file.hasLink(link("docs/design/Trip planner design.md"))
    order:
      - file.name
      - file.folder
  - type: cards
    name: Data sources
    filters: file.inFolder("library/data-sources")
    order:
      - file.name
      - kind
