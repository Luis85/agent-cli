{
  "name": "@luis85/forge-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only local developer webview for The Forge",
  "license": "MIT",
  "config": {
    "distribution": "../../bin/webviews/admin"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "package": "node scripts/package.mjs",
    "package:check": "node scripts/package.mjs --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "browsers:install": "playwright install chromium",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "tailwindcss": "^4.2.0",
    "vue": "3.5.43",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.0"
  }
}
