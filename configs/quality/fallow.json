{
  "$schema": "../../node_modules/fallow/schema.json",
  "minimumVersion": "3.31.0",
  "entry": ["src/the-forge/main.ts", "src/the-forge/sdk.ts", "tests/**/*.{unit,integration,e2e}.test.{ts,mts,cts,tsx,js,mjs,cjs,jsx}", "vite.config.ts", "docs/examples/plugins/*/main.mjs"],
  "ignorePatterns": ["bin/**", "release/**", "src/**", "!src/the-forge/**"],
  "failOnParseError": true,
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "boundary-violation": "error"
  },
  "boundaries": {
    "zones": [
      { "name": "domain", "patterns": ["src/the-forge/domain/**"] },
      { "name": "application", "patterns": ["src/the-forge/application/**"] },
      { "name": "infrastructure", "patterns": ["src/the-forge/infrastructure/**"] },
      { "name": "presentation", "patterns": ["src/the-forge/presentation/**"] }
    ],
    "rules": [
      { "from": "domain", "allow": ["domain"] },
      { "from": "application", "allow": ["domain", "application"] },
      { "from": "infrastructure", "allow": ["domain", "application", "infrastructure"] },
      { "from": "presentation", "allow": ["domain", "application", "presentation"] }
    ]
  }
}
